{
  "name": "agentquote-vscode",
  "displayName": "AgentQuote",
  "description": "Select text in a Claude Code terminal and click Quote to reply to it, like ChatGPT.",
  "version": "0.1.0",
  "publisher": "agentquote",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentquote.quoteSelection",
        "title": "Quote in Reply",
        "category": "AgentQuote",
        "icon": "$(quote)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentquote.quoteSelection",
          "when": "view == terminal && (terminalTextSelectedInFocused || terminalTextSelected)",
          "group": "navigation@0"
        }
      ],
      "terminal/context": [
        {
          "command": "agentquote.quoteSelection",
          "group": "0_agentquote"
        }
      ]
    },
    "configuration": {
      "title": "AgentQuote",
      "properties": {
        "agentquote.agentProcesses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "codex",
            "opencode"
          ],
          "description": "Process names AgentQuote may insert quotes into. Quotes are never inserted into a terminal that isn't running one of these."
        }
      }
    }
  }
}
