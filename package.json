{
  "name": "@omertt27/quote",
  "version": "0.1.0",
  "description": "ChatGPT-style inline replies for terminal AI coding agents. Quote part of an agent's output and reply in the same live session.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "quote": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "claude-code",
    "terminal",
    "pty",
    "tui",
    "quote",
    "reply",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:real": "vitest run --config vitest.real.config.ts",
    "demo": "QUOTE_CLAUDE_BIN=examples/mock-agent.mjs node dist/cli/main.js claude"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
